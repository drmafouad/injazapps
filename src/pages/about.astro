---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProseContent from '../components/ProseContent.astro';
import { parseProse } from '../lib/prose';

const entry = await getEntry('pages', 'about');
const doc = parseProse(entry!.body!);
---

<BaseLayout locale="en" path="/about" title="About — InjazApps" description="About InjazApps.">
  <ProseContent doc={doc} />
</BaseLayout>
