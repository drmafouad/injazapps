---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import OffsetPanel from '../../../components/OffsetPanel.astro';
---

<BaseLayout locale="ar" path="/apps/mizan" title="ميزان — InjazApps" description="ميزان، تطبيق من InjazApps.">
  <div class="app-header-band" aria-hidden="true"></div>
  <OffsetPanel>
    <p>قريباً.</p>
  </OffsetPanel>
</BaseLayout>

<style>
  /* Mizan's accent is Lamp Glass Teal — OwlMD and Sadā keep the default
     treatment until their icons exist. */
  .app-header-band {
    block-size: 8px;
    background-color: var(--accent-teal);
    margin-block-end: var(--space-lg);
  }
</style>
